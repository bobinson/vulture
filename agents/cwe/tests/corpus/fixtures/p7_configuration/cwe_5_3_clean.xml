<web-app xmlns="http://java.sun.com/xml/ns/javaee" version="3.1">
  <security-constraint>
    <web-resource-collection>
      <url-pattern>/public/*</url-pattern>
    </web-resource-collection>
  </security-constraint>
  <login-config>
    <auth-method>FORM</auth-method>
  </login-config>
</web-app>
