<web-app xmlns="http://java.sun.com/xml/ns/javaee" version="3.1">
  <security-constraint>
    <web-resource-collection>
      <url-pattern>/reports/*</url-pattern>
    </web-resource-collection>
    <auth-constraint>
      <role-name>auditor</role-name>
      <role-name>administrator</role-name>
    </auth-constraint>
  </security-constraint>
  <login-config>
    <auth-method>FORM</auth-method>
  </login-config>
</web-app>
