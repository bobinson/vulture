# Vulture Environment Configuration
# Copy this file to .env and fill in the required values:
#   cp .env.example .env
#
# Alternatively, use config.ini + gen-env.sh:
#   cp config.ini.example config.ini
#   make gen-env

# =============================================================================
# REQUIRED — docker-compose will refuse to start without these
# =============================================================================

# Database password (choose a strong password)
VULTURE_DB_PASSWORD=change-me-in-production

# JWT signing secret (generate with: openssl rand -hex 32)
VULTURE_JWT_SECRET=

# =============================================================================
# Application
# =============================================================================
VULTURE_APP_NAME=vulture

# Local mode (passwordless auth — set to true for development only)
VULTURE_LOCAL_MODE=false

# =============================================================================
# Ports
# =============================================================================
VULTURE_BACKEND_PORT=28080
VULTURE_AGENT_CHAOS_PORT=28001
VULTURE_AGENT_OWASP_PORT=28002
VULTURE_AGENT_SOC2_PORT=28003
VULTURE_AGENT_CWE_PORT=28004
VULTURE_AGENT_PROVE_PORT=28005
VULTURE_AGENT_XSS_PORT=28006
VULTURE_AGENT_SSDF_PORT=28007
VULTURE_AGENT_DISCOVER_PORT=28008
VULTURE_FRONTEND_INTERNAL=23000
VULTURE_FRONTEND_HOST=23001
VULTURE_POSTGRES_INTERNAL_PORT=25432
VULTURE_POSTGRES_HOST_PORT=25433

# =============================================================================
# Database
# =============================================================================
VULTURE_DB_NAME=vulture
VULTURE_DB_USER=vulture
VULTURE_DB_SQLITE_PATH=/data/vulture.db

# =============================================================================
# LLM Configuration (optional — skill-based audits work without LLM)
# =============================================================================

# Set to "true" to enable LLM-powered deep analysis after skill-based scanning
VULTURE_USE_LLM=false

# LLM model to use (supports OpenAI, Claude, Gemini, and local models via LiteLLM)
VULTURE_LLM_MODEL=gpt-4o

# Override context window size in tokens (auto-detected from model if unset).
# Behind a custom OPENAI_BASE_URL this is the ONLY authoritative source: a model
# missing from the built-in table silently falls back to 32K, however large it is.
# VULTURE_LLM_CTX_SIZE=262144

# Encoded request-body ceiling in bytes (default 131072 = 128KB ~ 32K tokens).
# Raise it alongside VULTURE_LLM_CTX_SIZE or it binds first and the larger window
# goes unused. Raise only for endpoints that accept it — a remote gateway may 413.
# VULTURE_LLM_MAX_BODY_BYTES=400000

# Window ceiling trusted when the resolved window is a GUESS and a custom
# OPENAI_BASE_URL is set (default 32000). Set VULTURE_LLM_CTX_SIZE to lift it.
# VULTURE_LLM_GATEWAY_GUESS_CTX=32000

# Feature 0075 rollback switch. Files sent to the LLM phase carry absolute line
# numbers ("30: code") so the model can cite a line instead of counting newlines;
# measured, raw files mislocated 78% of findings against 13% for numbered ones.
# Numbering costs ~5-7 chars per line of budget. false restores the pre-0075
# presentation (snippets stay numbered — that behaviour predates the switch).
# VULTURE_LLM_LINE_NUMBERS=true

# Extensions removed from the LLM PROMPT only (never from the scanner). SHIPS EMPTY:
# the evidence for excluding .graphql was confounded with the unnumbered-presentation
# defect 0075 fixes, and re-adjudication found 2 of 11 real. Populate it if you cannot
# send config dialects to a third-party provider, e.g. ".graphql,.gql".
# VULTURE_LLM_INELIGIBLE_EXTENSIONS=

# Send prose/data (.md .txt .csv .rst .adoc) to the LLM prompt. Default false on BUDGET
# grounds — doc text displaces real source inside a fixed character ceiling, not because
# prose is clean. Skills still scan it, and VULTURE_SECRET_SCAN_PROSE covers the gap.
# VULTURE_LLM_FEED_PROSE=false

# Lines of context each side of a finding in the LLM prompt. The default reproduces
# pre-0075 output byte-for-byte. Widening buys the model the guard that would refute a
# finding, and costs prompt budget (fewer files per batch).
# VULTURE_LLM_SNIPPET_CONTEXT=10

# Render files at or below this many lines WHOLE instead of windowed. 0 disables. For a
# small file the elision markers cost nearly what the omitted lines would.
# VULTURE_LLM_WHOLE_FILE_MAX_LINES=0

# Scan prose/data files for secrets. Default true — the compensating control for
# VULTURE_LLM_FEED_PROSE=false: a credential in a README would otherwise lose the only
# tier reading it. false re-opens that hole.
# VULTURE_SECRET_SCAN_PROSE=true

# Both LLM feed paths resolve ONE extension set. false restores the pre-0075
# asymmetry (narrow for the single-shot path, wide for the sweep) — that pair IS the
# defect two paths feeding one model, so this is an unblock hatch, not a config.
# VULTURE_LLM_FEED_UNIFY=true

# Feature 0059 cost guard. When false (the default) the LLM sweep is scoped to flagged
# plus entry/config files and the long tail is skipped — measured on one target, 828 of
# 2828 eligible files are rendered. This is a LARGER coverage factor than any prompt
# setting above, and it applies to every agent.
# VULTURE_LLM_TIER3=false

# --- Cooperative cancellation / runaway guards (feature 0061) ---------------
# Whole-audit wall-clock ceiling in seconds, shared across the skill, generate,
# and L5 phases. Backstops the disconnect fast-path so an audit can never run
# orphaned indefinitely. Must be >= the backend per-agent timeout (600s); 0
# disables (removes the hard guarantee — not recommended in prod).
# VULTURE_AGENT_MAX_AUDIT_SECONDS=900
# Per-LLM-call timeout (seconds); bounds each call so a hung/slow model cannot
# starve the cancel/deadline checks between batches.
# VULTURE_LLM_CALL_TIMEOUT_SEC=120
# Dedicated audit-producer thread pool size = per-agent concurrent-audit cap.
# VULTURE_AUDIT_EXECUTOR_WORKERS=8

# --- L5 judge budget and throughput (features 0046 / 0072) -------------------
# These decide how many findings the L5 LLM judge actually gets to look at. When
# the budget runs out, the remaining findings are NOT judged: they are stamped
# `coverage: skipped_budget_exhausted` and stay at validation_status=suspicious
# with confidence 0.50 — silently un-validated, not validated-and-cleared. If a
# big audit shows a wall of `suspicious` findings, check this first.
#
# THE CEILING CHAIN (this is the part that bites). L5's deadline is
#     min(now + VULTURE_VALIDATE_LLM_TIMEOUT_MS, whole-audit deadline)
# where the whole-audit deadline comes from VULTURE_AGENT_MAX_AUDIT_SECONDS and
# is shared with the skill and generate phases. The EARLIER one wins, so:
#   - raising VULTURE_VALIDATE_LLM_TIMEOUT_MS alone does nothing once the skill
#     phase has already eaten most of VULTURE_AGENT_MAX_AUDIT_SECONDS;
#   - VULTURE_AGENT_PROXY_TIMEOUT_SEC must stay >= the agent ceiling, or the
#     backend hangs up on the agent before it can finish.
# To give L5 more time you normally have to raise all three together.
#
# THROUGHPUT USUALLY MATTERS MORE THAN TIME. Work is
#     ceil(findings_selected / BATCH_SIZE) batches, MAX_CONCURRENCY at a time.
# 773 findings at batch 10 = 78 batches; at concurrency 5 and ~15 s/batch that
# is ~4 min of ideal work, so the 5-min default is borderline before any jitter.
# Raising concurrency past what the model server can actually serve in parallel
# only moves the queue (one LM Studio instance serializes regardless).

# Total wall-clock for the whole L5 phase, in MILLISECONDS. Default 300000 (5 min).
# VULTURE_VALIDATE_LLM_TIMEOUT_MS=300000

# Per-batch timeout, in MILLISECONDS. Default 30000. A local 30B model routinely
# takes 10-20 s per batch, so the default leaves almost no headroom — raise it
# before blaming the total budget.
# VULTURE_VALIDATE_LLM_PER_BATCH_TIMEOUT_MS=30000

# Batches run in parallel. Default 5.
# VULTURE_VALIDATE_LLM_MAX_CONCURRENCY=5

# Findings per LLM call. Default 10. Lower it to 1-3 when
# VULTURE_VALIDATE_LLM_TOOLS=true, so the tool-call budget serves few findings.
# VULTURE_VALIDATE_LLM_BATCH_SIZE=10

# Cap on how many findings are ELIGIBLE for L5 at all (ranked selection).
# Default 1000. Findings beyond it are stamped `skipped_not_selected` — a
# different stamp from budget exhaustion, and not a timeout problem.
# VULTURE_VALIDATE_LLM_TOP_N=1000

# =============================================================================
# Validation obligation gate (feature 0072) — read by the AGENTS
# =============================================================================
# Every finding that could be "confirmed" (high_confidence) carries a burden of
# proof (an "obligation"): e.g. for an injection candidate, "prove the tainted
# value reaches the sink unsanitised". The obligation resolves to discharged /
# unknown / refuted. This mode decides whether the gate may ACT on that proof.
#
#   observe  (default) — the proof state is computed and recorded, but it never
#                        changes a finding's status. Statuses come out exactly as
#                        they did pre-0072. This is the calibration phase: gather
#                        obligation data, review each vulnerability class, then
#                        enable enforcement per class as it is proven out.
#   enforce            — the gate withholds the "confirmed" stamp (→ suspicious)
#                        when a finding's obligation is unknown or refuted. This
#                        is what suppresses false positives in the confirmed tier.
#
# Why observe is the default: on a real run ~81% of findings carry no obligation
# check yet, so a global enforce today would leave a sound-but-empty confirmed
# tier — and could hide REAL issues whose class rules aren't reviewed yet. An
# eyeball-able false positive is safer than a silently-downgraded real bug.
# Set enforce when your goal is a clean confirmed tier; then also sanity-check
# what drops to suspicious. Takes effect only after the agents restart.
VULTURE_OBLIGATION_MODE=observe

# Kill switch (fast rollback): force the gate OFF even under enforce — every
# obligation is emitted as discharged, so the voter never withholds/dismisses on
# one. Default true (gate available).
# VULTURE_L5_OBLIGATIONS=true

# L5 judge closure admissibility. A lone promoting judge verdict may confirm a
# finding ALONE only if it asserted the analysis window was sufficient. Defaults
# to on in enforce mode; set true to require it while staying in observe mode.
# VULTURE_L5_PROMOTION_CLOSURE=

# =============================================================================
# Agent subprocess environment isolation (feature 0073) — native modes only
# =============================================================================
# Spawned Python agents get a FILTERED copy of the backend's environment: the
# backend's own credentials (JWT secret, DB DSN/password, webhook HMAC key,
# broker mint key, API keys) and interpreter/dynamic-linker injection vectors
# (LD_PRELOAD, LD_AUDIT, DYLD_*, PYTHONSTARTUP, PYTHONUSERBASE, PYTHONHOME, ...)
# are removed. All VULTURE_* CONFIGURATION still reaches the agent, as does
# VULTURE_AGENT_TOKEN, and provider keys are kept unless the broker is on.
# Docker mode is unaffected (compose enumerates agent env explicitly).
#
# Set false to restore the pre-0073 behaviour where agents inherit everything.
# VULTURE_AGENT_ENV_SCRUB=true
#
# Comma list of variable names to exempt from filtering, for a host that
# genuinely needs one. Injection vectors are refused even if listed here.
# VULTURE_AGENT_ENV_PASSTHROUGH=

# =============================================================================
# LLM Provider Keys (set the one matching your chosen model)
# =============================================================================

# OpenAI / OpenAI-compatible (LM Studio, vLLM, Ollama OpenAI mode)
OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:1234/v1

# Anthropic Claude
# ANTHROPIC_API_KEY=

# Google Gemini
# GEMINI_API_KEY=

# Ollama (local models)
# OLLAMA_API_BASE=http://localhost:11434

# =============================================================================
# Embedding (for memory/similarity search)
# =============================================================================
VULTURE_EMBEDDING_MODEL=text-embedding-3-small
# VULTURE_EMBEDDING_URL=

# =============================================================================
# Source directory mount (for docker-compose volume binding)
# =============================================================================
# VULTURE_SOURCE_DIR=./
