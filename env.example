# Vulture Environment Configuration
# Copy this file to .env and fill in the required values:
#   cp env.example .env
#
# Alternatively, use config.ini + gen-env.sh:
#   cp config.ini.example config.ini
#   make gen-env

# =============================================================================
# REQUIRED — docker-compose will refuse to start without these
# =============================================================================

# Database password (choose a strong password)
VULTURE_DB_PASSWORD=change-me-in-production

# JWT signing secret (generate with: openssl rand -hex 32)
VULTURE_JWT_SECRET=

# =============================================================================
# Application
# =============================================================================
VULTURE_APP_NAME=vulture

# Local mode (passwordless auth — set to true for development only)
VULTURE_LOCAL_MODE=false

# =============================================================================
# Ports
# =============================================================================
VULTURE_BACKEND_PORT=28080
VULTURE_AGENT_CHAOS_PORT=28001
VULTURE_AGENT_OWASP_PORT=28002
VULTURE_AGENT_SOC2_PORT=28003
VULTURE_AGENT_CWE_PORT=28004
VULTURE_AGENT_PROVE_PORT=28005
VULTURE_AGENT_XSS_PORT=28006
VULTURE_AGENT_SSDF_PORT=28007
VULTURE_AGENT_DISCOVER_PORT=28008
VULTURE_FRONTEND_INTERNAL=23000
VULTURE_FRONTEND_HOST=23001
VULTURE_POSTGRES_INTERNAL_PORT=25432
VULTURE_POSTGRES_HOST_PORT=25433

# =============================================================================
# Database
# =============================================================================
VULTURE_DB_NAME=vulture
VULTURE_DB_USER=vulture
VULTURE_DB_SQLITE_PATH=/data/vulture.db

# =============================================================================
# LLM Configuration (optional — skill-based audits work without LLM)
# =============================================================================

# Set to "true" to enable LLM-powered deep analysis after skill-based scanning
VULTURE_USE_LLM=false

# LLM model to use (supports OpenAI, Claude, Gemini, and local models via LiteLLM)
VULTURE_LLM_MODEL=gpt-4o

# Override context window size in tokens (auto-detected from model if unset).
# Behind a custom OPENAI_BASE_URL this is the ONLY authoritative source: a model
# missing from the built-in table silently falls back to 32K, however large it is.
# VULTURE_LLM_CTX_SIZE=262144

# Encoded request-body ceiling in BYTES (default 131072 = 128KB ~ 32K tokens).
# Raise it alongside VULTURE_LLM_CTX_SIZE or it binds first and the larger window
# goes unused. Raise only for endpoints that accept it — a remote gateway may 413.
#
# The example previously read 400000, which is the default of a DIFFERENT
# setting (VULTURE_MAX_SOURCE_CHARS) measured in CHARACTERS, not bytes. Those two
# must not be conflated: 1 char is 1-4 bytes, which is exactly why a separate
# byte ceiling exists. Worse, 400000 is ABOVE the ~192KB body that produced the
# gateway 413 this control was added to prevent, so uncommenting the old example
# disabled the protection it appeared to configure.
# VULTURE_LLM_MAX_BODY_BYTES=131072

# Window ceiling trusted when the resolved window is a GUESS and a custom
# OPENAI_BASE_URL is set (default 32000). Set VULTURE_LLM_CTX_SIZE to lift it.
# VULTURE_LLM_GATEWAY_GUESS_CTX=32000

# Feature 0075 rollback switch. Files sent to the LLM phase carry absolute line
# numbers ("30: code") so the model can cite a line instead of counting newlines;
# measured, raw files mislocated 78% of findings against 13% for numbered ones.
# Numbering costs ~5-7 chars per line of budget. false restores the pre-0075
# presentation (snippets stay numbered — that behaviour predates the switch).
# VULTURE_LLM_LINE_NUMBERS=true

# Extensions removed from the LLM PROMPT only (never from the scanner). SHIPS EMPTY:
# the evidence for excluding .graphql was confounded with the unnumbered-presentation
# defect 0075 fixes, and re-adjudication found 2 of 11 real. Populate it if you cannot
# send config dialects to a third-party provider, e.g. ".graphql,.gql".
# VULTURE_LLM_INELIGIBLE_EXTENSIONS=

# Send prose/data (.md .txt .csv .rst .adoc) to the LLM prompt. Default false on BUDGET
# grounds — doc text displaces real source inside a fixed character ceiling, not because
# prose is clean. Skills still scan it, and VULTURE_SECRET_SCAN_PROSE covers the gap.
# VULTURE_LLM_FEED_PROSE=false

# Lines of context each side of a finding in the LLM prompt. The default reproduces
# pre-0075 output byte-for-byte. Widening buys the model the guard that would refute a
# finding, and costs prompt budget (fewer files per batch).
# VULTURE_LLM_SNIPPET_CONTEXT=10

# Render files at or below this many lines WHOLE instead of windowed. 0 disables. For a
# small file the elision markers cost nearly what the omitted lines would.
# VULTURE_LLM_WHOLE_FILE_MAX_LINES=0

# Scan prose/data files for secrets. Default true — the compensating control for
# VULTURE_LLM_FEED_PROSE=false: a credential in a README would otherwise lose the only
# tier reading it. false re-opens that hole.
# VULTURE_SECRET_SCAN_PROSE=true

# Both LLM feed paths resolve ONE extension set. false restores the pre-0075
# asymmetry (narrow for the single-shot path, wide for the sweep) — that pair IS the
# defect two paths feeding one model, so this is an unblock hatch, not a config.
# VULTURE_LLM_FEED_UNIFY=true

# Feature 0059 cost guard. When false (the default) the LLM sweep is scoped to flagged
# plus entry/config files and the long tail is skipped — measured on one target, 828 of
# 2828 eligible files are rendered. This is a LARGER coverage factor than any prompt
# setting above, and it applies to every agent.
# VULTURE_LLM_TIER3=false

# --- Evidence quotation and anchor verification (feature 0076) ---------------
# The LLM tier has to QUOTE the source it accuses, and the quote is then checked by
# whitespace-normalised string search in the cited file — no second model call and no
# network. Every actuator ships INERT: on these defaults 0076 only LABELS findings; it
# cannot move a line, demote a finding, or change a finding count. Roll back in this
# order, which never widens egress at any intermediate step:
#   QUOTE_DEMOTE_ABSENT -> QUOTE_REANCHOR -> QUOTE_VERIFY=off -> QUOTE_REQUIRED=false
#   -> TRUST_MODEL_SNIPPET=true -> COERCE_LINES=false -> JSON_SCAN=false
# VULTURE_DEDUP_PREFER_DETERMINISTIC (Go, backend) flips independently of all of these.

# Parse a bare (unfenced) JSON array by scanning for balanced arrays rather than the old
# `\[.*\]` regex, which truncates at the first `}]`. One finding whose evidence quote
# contained `}]` (e.g. `const rows = [{ id: 1 }]`) therefore lost the WHOLE batch — a
# code-bearing field cannot cross that regex. The fenced path is tried first and is
# unchanged, so a compliant model is unaffected byte for byte. false restores the regex.
# VULTURE_LLM_JSON_SCAN=true

# Recover whole rows from an array the model never closed because it hit
# VULTURE_LLM_MAX_OUTPUT_TOKENS. Without it a response cut mid-array is a total loss of
# the batch. Never silent: emits `llm_json_salvaged` with the recovered row count.
# VULTURE_LLM_JSON_SALVAGE=true

# Coerce line_start/line_end to int, then clamp line_end >= line_start >= 0. A model that
# answers "55" is otherwise dropped in SILENCE by Go's `LineStart int` unmarshal — the
# finding reaches the backend and disappears there, invisibly from the agent side.
# VULTURE_LLM_COERCE_LINES=true

# true readmits a model-AUTHORED code_snippet as if it had been read from source. Off
# because that string is the model's paraphrase, not evidence: code_snippet is produced
# only by reading the FILE. Rollback hatch, not a supported configuration.
# VULTURE_LLM_TRUST_MODEL_SNIPPET=false

# true restores a model-authored check_id as the dedup identity. Separate from
# TRUST_MODEL_SNIPPET because it is a different risk: _dedup_key prefers check_id over the
# normalised title, so stripping it RE-KEYS structured-path rows and could collide one onto
# a skill row and delete it. The strip preserves the value privately and _dedup_key falls
# back to it, so the post-dedup count is invariant — this switch is the escape hatch for an
# operator who nonetheless sees a dedup regression.
# VULTURE_LLM_TRUST_MODEL_CHECK_ID=false

# Both prompt contracts ask for `evidence_quote` and the field whitelist admits it. Without
# it a volunteered quote is discarded, and "does this claim exist where it says it does" is
# undecidable by anything cheaper than a second model call. The quote NEVER egresses in any
# configuration: it is private and is stripped before SSE, the DB and the L5 prompt.
# VULTURE_LLM_QUOTE_REQUIRED=true

# off / observe (default) / enforce — a mode string, matching VULTURE_OBLIGATION_MODE.
# observe runs the verifier and records exact / reanchored / ambiguous / near_miss /
# found_elsewhere / absent / unquoted / unreadable / oversize in the `anchor` check's extras
# inside the persisted validation blob, changing nothing else. enforce merely ARMS the two
# actuators below, each of which is still individually off. off skips the verifier.
# VULTURE_LLM_QUOTE_VERIFY=observe

# The LINE actuator; requires enforce. true rewrites line_start/line_end when the quote is
# found elsewhere in the cited file (status `reanchored`), retaining claimed_line and only
# within QUOTE_MAX_DELTA. Off on ship because moving a CORRECT line to a wrong one is the
# one way this feature could lose a finding. VULTURE_DEDUP_PREFER_DETERMINISTIC is its hard
# prerequisite: re-anchoring creates the dedup collisions that guard arbitrates.
# VULTURE_LLM_QUOTE_REANCHOR=false

# The ONLY demoting actuator; requires enforce. true gives status `absent` weight -1.0 AND
# puts `anchor` in AUTHORITATIVE_CHECKS. One switch for both halves deliberately: the weight
# alone already drives confidence to 0.0 and puts high_confidence out of reach through the
# ADDITIVE path, with no authoritative check in the blob to explain it. No other status
# demotes and no status promotes — a located claim is not a true one.
# VULTURE_LLM_QUOTE_DEMOTE_ABSENT=false

# true retains a REDACTED copy of the quote (the same redaction code_snippet gets) in the
# validation extras, for offline debugging of the verifier. The raw quote never egresses
# under any setting, so this widens what is PERSISTED, not whether verification works.
# VULTURE_LLM_QUOTE_KEEP_TEXT=false

# --- 0076 signal floor and candidate selection (eight numeric knobs) ---------
# All eight are read at call time. An unset or unparseable value falls back to the default
# shown below, never to zero.

# Minimum whitespace-normalised length before a quote is searchable at all; below it the
# status is `unquoted`, never `absent`. Guards the degenerate quote (`}`, `return;`) that
# would match hundreds of lines. Measured: at this floor (24 chars AND 2 tokens) 82.0% of
# source positions still admit a qualifying window.
# VULTURE_LLM_QUOTE_MIN_CHARS=24

# The other half of the floor, in identifier tokens rather than characters. Separable on
# purpose: 24 characters of punctuation is not a signal. BOTH halves must pass.
# VULTURE_LLM_QUOTE_MIN_TOKENS=2

# A quote may span at most this many consecutive non-blank lines. In-file uniqueness of the
# matched window rises 85.3% (1 line) -> 89.5% (2) -> 92.5% (3); past that the extra lines
# cost prompt budget without buying uniqueness.
# VULTURE_LLM_QUOTE_MAX_LINES=3

# PER-LINE cap. Any single quoted line longer than this yields `unquoted` with reason
# line_too_long — a minified line is not evidence. 400 matches the existing per-line caps in
# tools/snippet.py and the L5 judge, so all three agree.
# VULTURE_LLM_QUOTE_MAX_LINE_CHARS=400

# WHOLE-QUOTE cap (3 x MAX_LINE_CHARS). Separate from the per-line cap because three
# individually legal lines are still an oversized payload. Over it the quote is whole-line
# truncated and then evaluated, hard-clamped so truncation can never make it `absent`.
# VULTURE_LLM_QUOTE_MAX_CHARS=1200

# Lines. When a quote matches in several places, the nearest candidate re-anchors only if it
# is within RADIUS of the claimed line AND strictly nearer than the runner-up; otherwise
# `ambiguous`. A LONE candidate re-anchors regardless — RADIUS arbitrates BETWEEN
# candidates, it is not a search bound.
# VULTURE_LLM_QUOTE_RADIUS=25

# Absolute ceiling, in lines, on how far re-anchoring may move a finding. A 200+ line
# correction is likelier a coincidental match than a corrected claim, so beyond it the line
# is left where the model put it.
# VULTURE_LLM_QUOTE_MAX_DELTA=200

# Similarity at or above which a non-matching window counts as `near_miss` rather than
# `absent` — the model reformatted rather than invented. ASSERTED, not measured: the one
# knob here with no corpus behind it, and it exists to keep the single demoting class
# narrow. Raise it to demote more, lower it to demote less.
# VULTURE_LLM_QUOTE_NEAR_MISS_MIN=0.6

# GO / backend switch, not an agent one. On a cross-agent dedup collision a deterministic
# (skill) row outranks an `llm` row at equal-or-lower severity, replacing 0075's score-only
# "richer row wins". Hard prerequisite of VULTURE_LLM_QUOTE_REANCHOR: moving an LLM row's
# line CREATES collisions that did not previously exist, and without this guard the LLM row
# can displace the skill row that found the same thing. Scope is exactly
# llm-vs-deterministic; det-vs-det, llm-vs-llm and rollup collisions still go to the detail
# score. false restores 0075 winner selection.
# VULTURE_DEDUP_PREFER_DETERMINISTIC=true

# --- Cooperative cancellation / runaway guards (feature 0061) ---------------
# Whole-audit wall-clock ceiling in seconds, shared across the skill, generate,
# and L5 phases. Backstops the disconnect fast-path so an audit can never run
# orphaned indefinitely.
#
# MARGIN RULE, agent side (feature 0078). Keep this value at or below
#     VULTURE_AGENT_PROXY_TIMEOUT_SEC - VULTURE_LLM_CALL_TIMEOUT_SEC
# — the same rule as the MARGIN RULE block further down, written from the knob
# you are setting here. The backend ceiling must clear this one by a WHOLE llm
# call, because an agent checks its own deadline only BETWEEN calls: once the
# deadline passes it can still be inside one call for a full
# VULTURE_LLM_CALL_TIMEOUT_SEC before it looks again. If the backend closes
# first, the agent logs `audit_cancelled reason=stream_closed`, never sends its
# result snapshot, and its findings are rescued from the delta path WITHOUT
# provenance, validation, snippets or score. The pre-0078 wording here had this
# ordering backwards; measured, 7500/7200/600 satisfied that wording and still
# truncated four agents at exactly 2h5m.
#
# The SHIPPED DEFAULTS DO NOT SATISFY THE RULE. This agent-side default is 900
# while the backend defaults to 600 with a 120s call budget, so 900 > 600 - 120.
# Fix it on one side: this value to 480, or VULTURE_AGENT_PROXY_TIMEOUT_SEC to
# 1020 or more (docker compose already ships 1200, which covers 900 + 120).
# An UNSET value is NOT a disabled deadline — the agent still stops itself at
# 900 — so the backend's startup check assumes 900 when the var is absent and
# WILL warn on pure defaults. Only an explicit 0 disables the deadline, and
# then the check goes quiet because nothing can overshoot.
#
# 0 disables (removes the hard guarantee — not recommended in prod).
# VULTURE_AGENT_MAX_AUDIT_SECONDS=900
# Per-LLM-call timeout (seconds); bounds each call so a hung/slow model cannot
# starve the cancel/deadline checks between batches.
# VULTURE_LLM_CALL_TIMEOUT_SEC=120
# Dedicated audit-producer thread pool size = per-agent concurrent-audit cap.
# VULTURE_AUDIT_EXECUTOR_WORKERS=8
#
# ─── KNOWN-GOOD PROFILES ────────────────────────────────────────────────────
# Two configurations that work, and the evidence for each. Copy one wholesale;
# mixing them is what produces the failures described below.
#
# PROFILE A — REMOTE / CLOUD MODEL (OpenAI, Anthropic, Gemini, a hosted gateway)
#
#   Keep every timeout at its default. They were sized for this case: a cloud
#   call returns in seconds, so 120s per call and a 600s per-agent ceiling are
#   generous. One caveat even here: the all-defaults trio violates the MARGIN
#   RULE (agent 900 vs backend 600 + call 120), so a run that DOES overrun is
#   truncated rather than returning partial results honestly. It rarely bites on
#   a cloud model because the run finishes long before the ceiling; if yours does
#   reach it, apply the fix in the MARGIN RULE block above (lower
#   VULTURE_AGENT_MAX_AUDIT_SECONDS to 480, or raise
#   VULTURE_AGENT_PROXY_TIMEOUT_SEC to 1020+). Set only:
#
#     OPENAI_API_KEY=sk-...            (or ANTHROPIC_API_KEY / GEMINI_API_KEY)
#     VULTURE_LLM_MODEL=gpt-4o
#     VULTURE_USE_LLM=true
#
#   Do NOT raise VULTURE_LLM_MAX_BODY_BYTES here. The 128KB default is
#   deliberately BELOW the ~192KB body that produced a gateway 413; a hosted
#   gateway is exactly the thing that rejects a large body, and a cap above the
#   failure cannot prevent it.
#
# PROFILE B — LOCAL LM STUDIO / OLLAMA (measured on qwen3.6-35b-a3b)
#
#   A local model behind several concurrent agents is a different regime, and
#   the defaults are wrong for it in BOTH directions: the timeouts are far too
#   tight, and the body ceiling is too small to use the window you have.
#
#   RAISE EVERY RUNG, not just the outer ones. The ladder binds at its LOWEST
#   rung, so one default left in place caps the whole run: set every value
#   listed below, not only the two that look outermost.
#
#   Measured on this hardware, 8-11 agents against ONE LM Studio instance:
#     * a 64-token "reply ok" call took 84.8s — the 120s default leaves no
#       headroom at all for a real batch;
#     * on the 120s default, five agents aborted at batch 3 of ~27 with ~90% of
#       their hour-long budget unspent;
#     * a 10-agent scan of a 7,598-file tree runs well over two hours.
#
#     OPENAI_BASE_URL=http://localhost:1234/v1
#     OPENAI_API_KEY=lm-studio                     # any non-empty string
#     VULTURE_LLM_MODEL=qwen/qwen3.6-35b-a3b
#     VULTURE_USE_LLM=true
#     VULTURE_LLM_CTX_SIZE=262144                  # REQUIRED: behind a custom
#                                                  # base URL an unknown model
#                                                  # silently falls back to 32K
#     VULTURE_LLM_MAX_BODY_BYTES=400000            # safe HERE (no gateway in
#                                                  # front); without it the
#                                                  # 128KB default binds first
#                                                  # and the 256K window is
#                                                  # mostly unused
#     VULTURE_AGENT_PROXY_TIMEOUT_SEC=7800         # see the MARGIN RULE below
#     VULTURE_AGENT_MAX_AUDIT_SECONDS=7200         # shared: skill + generate + L5
#     VULTURE_AGENT_RESPONSE_HEADER_TIMEOUT_SEC=900   # wait for first response byte
#     VULTURE_LLM_CALL_TIMEOUT_SEC=600             # generate, per call
#     VULTURE_VALIDATE_LLM_TIMEOUT_MS=1800000      # L5 judge, whole phase
#     VULTURE_VALIDATE_LLM_PER_BATCH_TIMEOUT_MS=600000   # L5 judge, per batch
#     VULTURE_PROVE_FINDING_TIMEOUT=600            # prove agent, per finding
#
#   MARGIN RULE — the one that is easy to get wrong:
#       PROXY >= MAX_AUDIT + LLM_CALL_TIMEOUT      (7800 >= 7200 + 600)
#   NOT merely PROXY >= MAX_AUDIT. An agent checks its own deadline only
#   BETWEEN llm calls, so after the deadline passes it can still be inside one
#   call for a full LLM_CALL_TIMEOUT before it looks. If the backend closes
#   first, the agent never sends its result snapshot and its findings are
#   rescued from the delta path WITHOUT provenance, validation, snippets or
#   score. Measured: 7500/7200/600 satisfied the old rule and still truncated
#   four agents at exactly 2h5m. The backend warns at startup when the margin
#   is unsafe — read that warning.
#
#   Leave VULTURE_VALIDATE_LLM_MAX_CONCURRENCY at its default. One LM Studio
#   instance serialises regardless, so raising it only moves the queue.
#
#   Timeouts buy honest partial coverage, not full coverage: N agents sharing
#   one local instance outruns any per-call budget. The real lever is FEWER
#   AGENTS PER PASS — run the scan agents you need, not all of them.

# --- L5 judge budget and throughput (features 0046 / 0072) -------------------
# These decide how many findings the L5 LLM judge actually gets to look at. When
# the budget runs out, the remaining findings are NOT judged: they are stamped
# `coverage: skipped_budget_exhausted` and stay at validation_status=suspicious
# with confidence 0.50 — silently un-validated, not validated-and-cleared. If a
# big audit shows a wall of `suspicious` findings, check this first.
#
# THE CEILING CHAIN (this is the part that bites). L5's deadline is
#     min(now + VULTURE_VALIDATE_LLM_TIMEOUT_MS, whole-audit deadline)
# where the whole-audit deadline comes from VULTURE_AGENT_MAX_AUDIT_SECONDS and
# is shared with the skill and generate phases. The EARLIER one wins, so:
#   - raising VULTURE_VALIDATE_LLM_TIMEOUT_MS alone does nothing once the skill
#     phase has already eaten most of VULTURE_AGENT_MAX_AUDIT_SECONDS;
#   - VULTURE_AGENT_PROXY_TIMEOUT_SEC must stay >= VULTURE_AGENT_MAX_AUDIT_SECONDS
#     + VULTURE_LLM_CALL_TIMEOUT_SEC (the MARGIN RULE above — NOT merely >= the
#     agent ceiling, which leaves the backend free to hang up while the agent is
#     still inside its last llm call, losing the whole result snapshot).
# To give L5 more time you normally have to raise all three together.
#
# THROUGHPUT USUALLY MATTERS MORE THAN TIME. Work is
#     ceil(findings_selected / BATCH_SIZE) batches, MAX_CONCURRENCY at a time.
# 773 findings at batch 10 = 78 batches; at concurrency 5 and ~15 s/batch that
# is ~4 min of ideal work, so the 5-min default is borderline before any jitter.
# Raising concurrency past what the model server can actually serve in parallel
# only moves the queue (one LM Studio instance serializes regardless).

# Total wall-clock for the whole L5 phase, in MILLISECONDS. Default 300000 (5 min).
# VULTURE_VALIDATE_LLM_TIMEOUT_MS=300000

# Per-batch timeout, in MILLISECONDS. Default 30000. A local 30B model routinely
# takes 10-20 s per batch, so the default leaves almost no headroom — raise it
# before blaming the total budget.
# VULTURE_VALIDATE_LLM_PER_BATCH_TIMEOUT_MS=30000

# Batches run in parallel. Default 5.
# VULTURE_VALIDATE_LLM_MAX_CONCURRENCY=5

# Findings per LLM call. Default 10. Lower it to 1-3 when
# VULTURE_VALIDATE_LLM_TOOLS=true, so the tool-call budget serves few findings.
# VULTURE_VALIDATE_LLM_BATCH_SIZE=10

# Cap on how many findings are ELIGIBLE for L5 at all (ranked selection).
# Default 1000. Findings beyond it are stamped `skipped_not_selected` — a
# different stamp from budget exhaustion, and not a timeout problem.
# VULTURE_VALIDATE_LLM_TOP_N=1000

# =============================================================================
# Validation obligation gate (feature 0072) — read by the AGENTS
# =============================================================================
# Every finding that could be "confirmed" (high_confidence) carries a burden of
# proof (an "obligation"): e.g. for an injection candidate, "prove the tainted
# value reaches the sink unsanitised". The obligation resolves to discharged /
# unknown / refuted. This mode decides whether the gate may ACT on that proof.
#
#   observe  (default) — the proof state is computed and recorded, but it never
#                        changes a finding's status. Statuses come out exactly as
#                        they did pre-0072. This is the calibration phase: gather
#                        obligation data, review each vulnerability class, then
#                        enable enforcement per class as it is proven out.
#   enforce            — the gate withholds the "confirmed" stamp (→ suspicious)
#                        when a finding's obligation is unknown or refuted. This
#                        is what suppresses false positives in the confirmed tier.
#
# Why observe is the default: on a real run ~81% of findings carry no obligation
# check yet, so a global enforce today would leave a sound-but-empty confirmed
# tier — and could hide REAL issues whose class rules aren't reviewed yet. An
# eyeball-able false positive is safer than a silently-downgraded real bug.
# Set enforce when your goal is a clean confirmed tier; then also sanity-check
# what drops to suspicious. Takes effect only after the agents restart.
VULTURE_OBLIGATION_MODE=observe

# Kill switch (fast rollback): force the gate OFF even under enforce — every
# obligation is emitted as discharged, so the voter never withholds/dismisses on
# one. Default true (gate available).
# VULTURE_L5_OBLIGATIONS=true

# L5 judge closure admissibility. A lone promoting judge verdict may confirm a
# finding ALONE only if it asserted the analysis window was sufficient. Defaults
# to on in enforce mode; set true to require it while staying in observe mode.
# VULTURE_L5_PROMOTION_CLOSURE=

# =============================================================================
# Agent subprocess environment isolation (feature 0073) — native modes only
# =============================================================================
# Spawned Python agents get a FILTERED copy of the backend's environment: the
# backend's own credentials (JWT secret, DB DSN/password, webhook HMAC key,
# broker mint key, API keys) and interpreter/dynamic-linker injection vectors
# (LD_PRELOAD, LD_AUDIT, DYLD_*, PYTHONSTARTUP, PYTHONUSERBASE, PYTHONHOME, ...)
# are removed. All VULTURE_* CONFIGURATION still reaches the agent, as does
# VULTURE_AGENT_TOKEN, and provider keys are kept unless the broker is on.
# Docker mode is unaffected (compose enumerates agent env explicitly).
#
# Set false to restore the pre-0073 behaviour where agents inherit everything.
# VULTURE_AGENT_ENV_SCRUB=true
#
# Comma list of variable names to exempt from filtering, for a host that
# genuinely needs one. Injection vectors are refused even if listed here.
# VULTURE_AGENT_ENV_PASSTHROUGH=

# =============================================================================
# LLM Provider Keys (set the one matching your chosen model)
# =============================================================================

# OpenAI / OpenAI-compatible (LM Studio, vLLM, Ollama OpenAI mode)
OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:1234/v1

# Anthropic Claude
# ANTHROPIC_API_KEY=

# Google Gemini
# GEMINI_API_KEY=

# Ollama (local models)
# OLLAMA_API_BASE=http://localhost:11434

# =============================================================================
# Embedding (for memory/similarity search)
# =============================================================================
VULTURE_EMBEDDING_MODEL=text-embedding-3-small
# VULTURE_EMBEDDING_URL=

# =============================================================================
# Source directory mount (for docker-compose volume binding)
# =============================================================================
# VULTURE_SOURCE_DIR=./
