# eslint-plugin-react-hooks@7 peers only to eslint <=9, but the toolchain is on
# eslint 10 (ahead of the plugin's peer range). The resolved lockfile is valid;
# this lets `npm ci` install it without failing peer-dependency validation.
# Remove once eslint-plugin-react-hooks publishes an eslint-10 peer range.
legacy-peer-deps=true
