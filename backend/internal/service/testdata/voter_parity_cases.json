{
  "_comment": [
    "Cross-language voter parity fixture. Consumed by BOTH",
    "backend/internal/service/validation_voter_parity_test.go and",
    "agents/shared/tests/unit/validate/test_voter_parity.py.",
    "",
    "Both must produce identical (status, confidence) for every case. This file",
    "is the contract; adding a rule to either voter without adding a case here is",
    "the failure mode it exists to catch.",
    "",
    "Built by feature 0072. Before it, both voter headers described this test and",
    "the Python one claimed CI enforced it — neither the fixture nor either test",
    "existed, so the two implementations were free to drift silently."
  ],
  "cases": [
    {
      "name": "empty check list is the 0.5 prior",
      "checks": [],
      "want": {
        "status": "suspicious",
        "confidence": 0.5
      }
    },
    {
      "name": "single promoting check crosses 0.55",
      "checks": [
        {
          "id": "path",
          "weight": 0.1,
          "result": "promoted"
        }
      ],
      "want": {
        "status": "high_confidence",
        "confidence": 0.6
      }
    },
    {
      "name": "confidence clamps at 1.0",
      "checks": [
        {
          "id": "llm_judge",
          "weight": 0.75,
          "result": "real_bug"
        },
        {
          "id": "memory",
          "weight": 0.4,
          "result": "user_label"
        }
      ],
      "want": {
        "status": "high_confidence",
        "confidence": 1.0
      }
    },
    {
      "name": "confidence clamps at 0.0",
      "checks": [
        {
          "id": "llm_judge",
          "weight": -0.75,
          "result": "advisory"
        },
        {
          "id": "path",
          "weight": -0.2,
          "result": "demoted"
        }
      ],
      "want": {
        "status": "likely_fp",
        "confidence": 0.0
      }
    },
    {
      "name": "likely_fp needs TWO demoting checks",
      "checks": [
        {
          "id": "llm_judge",
          "weight": -0.6,
          "result": "advisory"
        }
      ],
      "want": {
        "status": "suspicious",
        "confidence": 0.0
      }
    },
    {
      "name": "authoritative demotion is singular, and caps confidence at 0.05",
      "_note": "weight -0.2 leaves confidence at 0.3 so the min(conf, 0.05) cap actually bites; -0.5 would reach 0.0 on its own and test nothing",
      "checks": [
        {
          "id": "suppression",
          "weight": -0.2,
          "result": "nosec"
        }
      ],
      "want": {
        "status": "likely_fp",
        "confidence": 0.05
      }
    },
    {
      "name": "authoritative demotion below the cap keeps its lower confidence",
      "checks": [
        {
          "id": "suppression",
          "weight": -0.5,
          "result": "nosec"
        }
      ],
      "want": {
        "status": "likely_fp",
        "confidence": 0.0
      }
    },
    {
      "name": "0072: unknown obligation withholds the label, keeps the number",
      "checks": [
        {
          "id": "path",
          "weight": 0.1,
          "result": "promoted"
        },
        {
          "id": "llm_judge",
          "weight": 0.6,
          "result": "real_bug"
        },
        {
          "id": "obligation",
          "weight": 0.0,
          "result": "unknown"
        }
      ],
      "want": {
        "status": "suspicious",
        "confidence": 0.99
      },
      "_note": "Confidence 0.99, not 1.0: T4.2 reserves certainty for ground truth (the case carries no positive operator label)."
    },
    {
      "name": "0072: discharged obligation permits confirmation",
      "checks": [
        {
          "id": "path",
          "weight": 0.1,
          "result": "promoted"
        },
        {
          "id": "obligation",
          "weight": 0.0,
          "result": "discharged"
        }
      ],
      "want": {
        "status": "high_confidence",
        "confidence": 0.6
      }
    },
    {
      "name": "0072: a refuted obligation dismisses the finding",
      "checks": [
        {
          "id": "path",
          "weight": 0.1,
          "result": "promoted"
        },
        {
          "id": "obligation",
          "weight": 0.0,
          "result": "refuted"
        }
      ],
      "want": {
        "status": "likely_fp",
        "confidence": 0.6
      }
    },
    {
      "name": "0072: operator POSITIVE label overrides a blocking obligation",
      "checks": [
        {
          "id": "memory",
          "weight": 0.4,
          "result": "user_label"
        },
        {
          "id": "obligation",
          "weight": 0.0,
          "result": "unknown"
        }
      ],
      "want": {
        "status": "high_confidence",
        "confidence": 0.9
      }
    },
    {
      "name": "0072: operator NEGATIVE label never grants an override",
      "checks": [
        {
          "id": "memory",
          "weight": -0.4,
          "result": "user_label"
        },
        {
          "id": "llm_judge",
          "weight": 0.6,
          "result": "real_bug"
        },
        {
          "id": "obligation",
          "weight": 0.0,
          "result": "unknown"
        }
      ],
      "want": {
        "status": "suspicious",
        "confidence": 0.7
      }
    },
    {
      "name": "0072: lone UNCITED judge promotion cannot confirm",
      "checks": [
        {
          "id": "llm_judge",
          "weight": 0.6,
          "result": "real_bug_uncited"
        },
        {
          "id": "obligation",
          "weight": 0.0,
          "result": "discharged"
        }
      ],
      "want": {
        "status": "suspicious",
        "confidence": 0.99
      },
      "_note": "Confidence 0.99, not 1.0: T4.2 reserves certainty for ground truth (the case carries no positive operator label)."
    },
    {
      "name": "0072: lone CITED judge promotion may confirm",
      "checks": [
        {
          "id": "llm_judge",
          "weight": 0.6,
          "result": "real_bug"
        },
        {
          "id": "obligation",
          "weight": 0.0,
          "result": "discharged"
        }
      ],
      "want": {
        "status": "high_confidence",
        "confidence": 0.99
      },
      "_note": "Confidence 0.99, not 1.0: T4.2 reserves certainty for ground truth (the case carries no positive operator label)."
    },
    {
      "name": "0072: legacy judge result fails closed",
      "checks": [
        {
          "id": "llm_judge",
          "weight": 0.6,
          "result": "real_bug_legacy"
        },
        {
          "id": "obligation",
          "weight": 0.0,
          "result": "discharged"
        }
      ],
      "want": {
        "status": "suspicious",
        "confidence": 0.99
      },
      "_note": "Confidence 0.99, not 1.0: T4.2 reserves certainty for ground truth (the case carries no positive operator label)."
    },
    {
      "name": "0072: lone deterministic promotion is untouched by the judge rule",
      "checks": [
        {
          "id": "sanitizer",
          "weight": 0.15,
          "result": "matched"
        },
        {
          "id": "obligation",
          "weight": 0.0,
          "result": "discharged"
        }
      ],
      "want": {
        "status": "high_confidence",
        "confidence": 0.65
      }
    },
    {
      "name": "0072: uncited judge alongside a deterministic promoter confirms",
      "checks": [
        {
          "id": "path",
          "weight": 0.1,
          "result": "promoted"
        },
        {
          "id": "llm_judge",
          "weight": 0.6,
          "result": "real_bug_uncited"
        },
        {
          "id": "obligation",
          "weight": 0.0,
          "result": "discharged"
        }
      ],
      "want": {
        "status": "high_confidence",
        "confidence": 0.99
      },
      "_note": "Confidence 0.99, not 1.0: T4.2 reserves certainty for ground truth (the case carries no positive operator label)."
    },
    {
      "name": "0072: a demoting check is never counted as a promoter",
      "checks": [
        {
          "id": "llm_judge",
          "weight": 0.6,
          "result": "real_bug_uncited"
        },
        {
          "id": "path",
          "weight": -0.2,
          "result": "demoted"
        },
        {
          "id": "obligation",
          "weight": 0.0,
          "result": "discharged"
        }
      ],
      "want": {
        "status": "suspicious",
        "confidence": 0.9
      }
    },
    {
      "name": "0072: blocking obligation does not prevent dismissal",
      "checks": [
        {
          "id": "llm_judge",
          "weight": -0.6,
          "result": "advisory"
        },
        {
          "id": "path",
          "weight": -0.2,
          "result": "demoted"
        },
        {
          "id": "obligation",
          "weight": 0.0,
          "result": "unknown"
        }
      ],
      "want": {
        "status": "likely_fp",
        "confidence": 0.0
      }
    },
    {
      "name": "0072: no obligation check behaves exactly as pre-0072",
      "checks": [
        {
          "id": "path",
          "weight": 0.1,
          "result": "promoted"
        }
      ],
      "want": {
        "status": "high_confidence",
        "confidence": 0.6
      }
    },
    {
      "name": "0072: an UNDECIDED judge verdict asserts nothing",
      "checks": [
        {
          "id": "llm_judge",
          "weight": 0.0,
          "result": "undecided"
        },
        {
          "id": "obligation",
          "weight": 0.0,
          "result": "discharged"
        }
      ],
      "want": {
        "status": "suspicious",
        "confidence": 0.5
      }
    },
    {
      "name": "0072: an UNDECIDED judge neither promotes nor blocks a real promoter",
      "checks": [
        {
          "id": "path",
          "weight": 0.1,
          "result": "promoted"
        },
        {
          "id": "llm_judge",
          "weight": 0.0,
          "result": "undecided"
        },
        {
          "id": "obligation",
          "weight": 0.0,
          "result": "discharged"
        }
      ],
      "want": {
        "status": "high_confidence",
        "confidence": 0.6
      }
    },
    {
      "name": "0072 P6: a coverage check is inert in both voters",
      "_note": "AC7: L5 coverage is informational. weight 0.0 and an id no voter branch reads, so status and confidence are identical to the same case without it (single promoting check crosses 0.55).",
      "checks": [
        {
          "id": "path",
          "weight": 0.1,
          "result": "promoted"
        },
        {
          "id": "coverage",
          "weight": 0.0,
          "result": "skipped_l5_disabled"
        }
      ],
      "want": {
        "status": "high_confidence",
        "confidence": 0.6
      }
    },
    {
      "name": "0072 T4.2: a lone judge vote cannot reach certainty",
      "_note": "C2: exploitable >= 0.834 used to clamp to exactly 1.000. The ceiling is the clamp BOUND (0.99) so no equality test exists to drift between languages; only an authoritative positive lifts it.",
      "checks": [
        {
          "id": "llm_judge",
          "weight": 0.75,
          "result": "real_bug"
        }
      ],
      "want": {
        "status": "high_confidence",
        "confidence": 0.99
      }
    },
    {
      "name": "0072 T4.2: heuristic pile-up caps below certainty",
      "checks": [
        {
          "id": "path",
          "weight": 0.1,
          "result": "promoted"
        },
        {
          "id": "llm_judge",
          "weight": 0.75,
          "result": "real_bug"
        },
        {
          "id": "cross_agent",
          "weight": 0.3,
          "result": "corroborated"
        }
      ],
      "want": {
        "status": "high_confidence",
        "confidence": 0.99
      }
    },
    {
      "name": "0072 T4.2: a negative operator label does not lift the ceiling",
      "_note": "memory is bidirectional; a user's false-positive label must not grant the certainty reserved for confirmed-real findings. 0.5+0.75+0.3-0.4 = 1.15 -> clamped to 0.99.",
      "checks": [
        {
          "id": "llm_judge",
          "weight": 0.75,
          "result": "real_bug"
        },
        {
          "id": "path",
          "weight": 0.3,
          "result": "promoted"
        },
        {
          "id": "memory",
          "weight": -0.4,
          "result": "user_label"
        }
      ],
      "want": {
        "status": "high_confidence",
        "confidence": 0.99
      }
    },
    {
      "name": "0076: an absent anchor demotes authoritatively, solo",
      "_note": "feature 0076 seats `anchor` in the authoritative demoting set. ONE demoting check must reach likely_fp — the additive path could not (clamp(0.5+0.4-1.0)=0.0 with demoting_count=1 classifies as `suspicious`) — and the cap pins confidence at <=0.05. The operator's own positive label does not save it: an evidence quote that matches nowhere is mechanical, not advisory.",
      "checks": [
        {
          "id": "anchor",
          "weight": -1.0,
          "result": "absent"
        },
        {
          "id": "memory",
          "weight": 0.4,
          "result": "user_confirmed_real"
        }
      ],
      "want": {
        "status": "likely_fp",
        "confidence": 0.0
      }
    },
    {
      "name": "0076: an anchor check at weight 0.0 is inert in both voters",
      "_note": "VULTURE_LLM_QUOTE_DEMOTE_ABSENT=false makes the WEIGHT 0.0, not -1.0, so membership in the authoritative set cannot fire (both voters also require weight < 0). This is the switch-off half of AC34 expressed in the units the voters actually see.",
      "checks": [
        {
          "id": "anchor",
          "weight": 0.0,
          "result": "absent"
        },
        {
          "id": "path",
          "weight": 0.1,
          "result": "promoted"
        }
      ],
      "want": {
        "status": "high_confidence",
        "confidence": 0.6
      }
    },
    {
      "name": "0076: a located anchor status never promotes",
      "_note": "AC27: every status but `absent` carries weight exactly 0.0. A quote that WAS found is not evidence the accusation is true — on the adjudicated population the best-quoting rows include the worst false positives — so `exact` leaves the 0.5 prior alone.",
      "checks": [
        {
          "id": "anchor",
          "weight": 0.0,
          "result": "exact"
        }
      ],
      "want": {
        "status": "suspicious",
        "confidence": 0.5
      }
    }
  ]
}
